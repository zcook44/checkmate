      "rules": [
        {
          "comments": "NOT REVIEWED — raw running config supplied for manual review; no automated pass, finding, or applicability decision asserted.",
          "finding_details": "Raw running config SHA-256: aee75ec93771eedc6391a141a5fbdc3613409dcba611e39db2e0be67f47b8953\nOfficial Cisco benchmark SHA-256: 4c0e0c18d65fff727a5b64c39e6abf1a901b589d5c89cda1667b6e7aed58b215\nRunning config alone does not verify this control's complete operational check; manual review required.",
          "fix_text": "Configure the router to limit the number of concurrent management sessions to an organization-defined number as shown in the example below.\n\nRP/0/0/CPU0:R3(config)#ssh server session-limit 2",
          "group_id": "V-216522",
          "group_id_src": "V-216522",
          "group_title": "SRG-APP-000001-NDM-000200",
          "rule_id": "SV-216522r960735_rule",
          "rule_id_src": "SV-216522r960735_rule",
          "rule_title": "The Cisco router must be configured to limit the number of concurrent management sessions to an organization-defined number.",
          "rule_version": "CISC-ND-000010",
          "severity": "medium",
          "status": "not_reviewed",
          "stig_uuid": "21cd59c1-cf93-5622-b028-c123279563f9",
          "uuid": "39ea481c-02a6-5b4f-8a88-7e853f8f5093",
          "weight": "10.0"
        },
        {
          "comments": "NOT REVIEWED — raw running config supplied for manual review; no automated pass, finding, or applicability decision asserted.",
          "finding_details": "Raw running config SHA-256: aee75ec93771eedc6391a141a5fbdc3613409dcba611e39db2e0be67f47b8953\nOfficial Cisco benchmark SHA-256: 4c0e0c18d65fff727a5b64c39e6abf1a901b589d5c89cda1667b6e7aed58b215\nRunning config alone does not verify this control's complete operational check; manual review required.",
          "fix_text": "Configure the Cisco router to restrict management access to specific IP addresses via SSH as shown in the example below.\n\nRP/0/0/CPU0:ios(config)#ipv4 access-list MANAGEMENT_NET\nRP/0/0/CPU0:ios(config-ipv4-acl)#permit ipv4 10.1.1.0 255.255.255.0 any\nRP/0/0/CPU0:ios(config-ipv4-acl)#deny ipv4 any any log-input \nRP/0/0/CPU0:ios(config-ipv4-acl)#exit\nRP/0/0/CPU0:R3(config)#vty default 0 4 \nRP/0/0/CPU0:R3(config)#line default \nRP/0/0/CPU0:R3(config-line)#transport input ssh \nRP/0/0/CPU0:R3(config-line)#access-class MANAGEMENT_NET in \nRP/0/0/CPU0:R3(config-line)#end",
          "group_id": "V-216523",
          "group_id_src": "V-216523",
          "group_title": "SRG-APP-000038-NDM-000213",
          "rule_id": "SV-216523r1137875_rule",
          "rule_id_src": "SV-216523r1137875_rule",
          "rule_title": "The Cisco router must be configured to enforce approved authorizations for controlling the flow of management information within the device based on control policies.",
          "rule_version": "CISC-ND-000140",
          "severity": "medium",
          "status": "not_reviewed",
          "stig_uuid": "21cd59c1-cf93-5622-b028-c123279563f9",
          "uuid": "4ab1a155-056e-51f6-8063-926be0120210",
          "weight": "10.0"
        },
        {
          "comments": "NOT REVIEWED — raw running config supplied for manual review; no automated pass, finding, or applicability decision asserted.",
          "finding_details": "Raw running config SHA-256: aee75ec93771eedc6391a141a5fbdc3613409dcba611e39db2e0be67f47b8953\nOfficial Cisco benchmark SHA-256: 4c0e0c18d65fff727a5b64c39e6abf1a901b589d5c89cda1667b6e7aed58b215\nRunning config alone does not verify this control's complete operational check; manual review required.",
          "fix_text": "Step 1: Configure the router to use an authentication server as shown in the following example:\n\nRP/0/0/CPU0:R3(config)#radius-server host 10.1.3.16 key xxxxxxxx\n\nStep 2: Configure the authentication order to use the authentication server as primary source for authentication as shown in the following example:\n\nRP/0/0/CPU0:R3(config)#aaa authentication login LOGIN_AUTHENTICATION  group radius local\n\nStep 3: Configure all network connections associated with a device management to use an authentication server for the purpose of login authentication as shown in the following example:\n\nRP/0/0/CPU0:R3(config)#line default\nRP/0/0/CPU0:R3(config-line)#login authentication LOGIN_AUTHENTICATION\nRP/0/0/CPU0:R3(config-line)#exit\nRP/0/0/CPU0:R3(config)#line console \nRP/0/0/CPU0:R3(config-line)#login authentication LOGIN_AUTHENTICATION",
          "group_id": "V-216524",
          "group_id_src": "V-216524",
          "group_title": "SRG-APP-000065-NDM-000214",
          "rule_id": "SV-216524r960840_rule",
          "rule_id_src": "SV-216524r960840_rule",
          "rule_title": "The Cisco router must be configured to enforce the limit of three consecutive invalid logon attempts after which time lock out the user account from accessing the device for 15 minutes.",
          "rule_version": "CISC-ND-000150",
          "severity": "medium",
          "status": "not_reviewed",
          "stig_uuid": "21cd59c1-cf93-5622-b028-c123279563f9",
          "uuid": "98771649-6fdb-5040-ad50-13c110f236c9",
          "weight": "10.0"
        },
        {
          "comments": "NOT REVIEWED — raw running config supplied for manual review; no automated pass, finding, or applicability decision asserted.",
          "finding_details": "Raw running config SHA-256: aee75ec93771eedc6391a141a5fbdc3613409dcba611e39db2e0be67f47b8953\nOfficial Cisco benchmark SHA-256: 4c0e0c18d65fff727a5b64c39e6abf1a901b589d5c89cda1667b6e7aed58b215\nRunning config alone does not verify this control's complete operational check; manual review required.",
          "fix_text": "Configure the Cisco router to display the Standard Mandatory DoD Notice and Consent Banner before granting access as shown in the following example:\n\nRP/0/0/CPU0:R3(config)#banner login #\nEnter TEXT message. End with the character '#'.\nYou are accessing a U.S. Government (USG) Information System (IS) that is provided for USG-authorized use only.\n\nBy using this IS (which includes any device attached to this IS), you consent to the following conditions:\n\n-The USG routinely intercepts and monitors communications on this IS for purposes including, but not limited to, penetration testing, COMSEC monitoring, network operations and defense, personnel misconduct (PM), law enforcement (LE), and counterintelligence (CI) investigations.\n\n-At any time, the USG may inspect and seize data stored on this IS.\n\n-Communications using, or data stored on, this IS are not private, are subject to routine monitoring, interception, and search, and may be disclosed or used for any USG-authorized purpose.\n\n-This IS includes security measures (e.g., authentication and access controls) to protect USG interests--not for your personal benefit or privacy.\n\n-Notwithstanding the above, using this IS does not constitute consent to PM, LE or CI investigative searching or monitoring of the content of privileged communications, or work product, related to personal representation or services by attorneys, psychotherapists, or clergy, and their assistants. Such communications and work product are private and confidential. See User Agreement for details. #\nRP/0/0/CPU0:R3(config)#end",
          "group_id": "V-216525",
          "group_id_src": "V-216525",
          "group_title": "SRG-APP-000068-NDM-000215",
          "rule_id": "SV-216525r960843_rule",
          "rule_id_src": "SV-216525r960843_rule",
          "rule_title": "The Cisco router must be configured to display the Standard Mandatory DoD Notice and Consent Banner before granting access to the device.",
          "rule_version": "CISC-ND-000160",
          "severity": "medium",
          "status": "not_reviewed",
          "stig_uuid": "21cd59c1-cf93-5622-b028-c123279563f9",
          "uuid": "c7c45d12-c70b-5830-8327-c0535be70b40",
          "weight": "10.0"
        },
        {
          "comments": "NOT REVIEWED — raw running config supplied for manual review; no automated pass, finding, or applicability decision asserted.",
          "finding_details": "Raw running config SHA-256: aee75ec93771eedc6391a141a5fbdc3613409dcba611e39db2e0be67f47b8953\nOfficial Cisco benchmark SHA-256: 4c0e0c18d65fff727a5b64c39e6abf1a901b589d5c89cda1667b6e7aed58b215\nRunning config alone does not verify this control's complete operational check; manual review required.",
          "fix_text": "Configure the Cisco router to log all logon attempts as shown in the example below.\n\nRP/0/0/CPU0:R3(config)#logging buffered informational \nRP/0/0/CPU0:R3(config)#logging 10.1.22.2 severity info",
