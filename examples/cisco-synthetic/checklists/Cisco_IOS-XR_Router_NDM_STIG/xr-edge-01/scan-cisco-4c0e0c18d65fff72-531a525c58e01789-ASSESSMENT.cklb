          "rule_version": "CISC-ND-000980",
          "severity": "medium",
          "status": "not_reviewed",
          "stig_uuid": "21cd59c1-cf93-5622-b028-c123279563f9",
          "uuid": "60a33a08-6b73-5a68-af32-5267f89a9dc9",
