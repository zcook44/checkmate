        },
        {
          "comments": "NOT REVIEWED — raw running config supplied for manual review; no automated pass, finding, or applicability decision asserted.",
          "finding_details": "Raw running config SHA-256: 92b03138bac022b1f2b4e7d9befc64bcbf4a341a2c69f573cb2d172e209eb668\nOfficial Cisco benchmark SHA-256: b92cccf9a63b08507cc8f96c80c7e7976634036a5677a5b151e9aea4a180ef13\nRunning config alone does not verify this control's complete operational check; manual review required.",
          "fix_text": "Step 1: Configure a local account as shown in the example below.\n\nR2(config)#username xxxxxxxxx privilege nn secret xxxxxxx\n\nStep 2: Configure the authentication order to use the local account if the authentication server is not reachable as shown in the following example:\n\nR2(config)#aaa authentication login default group tacacs+ local",
          "group_id": "V-215679",
          "group_id_src": "V-215679",
          "group_title": "SRG-APP-000148-NDM-000346",
          "rule_id": "SV-215679r1051115_rule",
          "rule_id_src": "SV-215679r1051115_rule",
          "rule_title": "The Cisco router must be configured with only one local account to be used as the account of last resort in the event the authentication server is unavailable.",
          "rule_version": "CISC-ND-000490",
          "severity": "medium",
          "status": "not_reviewed",
          "stig_uuid": "253480f6-e09e-5530-94c9-6b470c156b35",
          "uuid": "b3c629f1-1b08-5265-88bb-389757b16422",
          "weight": "10.0"
        },
        {
          "comments": "NOT REVIEWED — raw running config supplied for manual review; no automated pass, finding, or applicability decision asserted.",
          "finding_details": "Raw running config SHA-256: 92b03138bac022b1f2b4e7d9befc64bcbf4a341a2c69f573cb2d172e209eb668\nOfficial Cisco benchmark SHA-256: b92cccf9a63b08507cc8f96c80c7e7976634036a5677a5b151e9aea4a180ef13\nRunning config alone does not verify this control's complete operational check; manual review required.",
          "fix_text": "Configure the Cisco router to enforce a minimum 15-character password length as shown in the example below.\n\nR1(config)#aaa common-criteria policy PASSWORD_POLICY\nR1(config-cc-policy)#min-length 15\nR1(config-cc-policy)#exit",
          "group_id": "V-215681",
          "group_id_src": "V-215681",
          "group_title": "SRG-APP-000164-NDM-000252",
          "rule_id": "SV-215681r991820_rule",
          "rule_id_src": "SV-215681r991820_rule",
          "rule_title": "The Cisco router must be configured to enforce a minimum 15-character password length.",
          "rule_version": "CISC-ND-000550",
          "severity": "medium",
          "status": "not_reviewed",
          "stig_uuid": "253480f6-e09e-5530-94c9-6b470c156b35",
          "uuid": "b3c7a7d9-763b-550d-9be7-cc18150d30a3",
          "weight": "10.0"
        },
        {
          "comments": "NOT REVIEWED — raw running config supplied for manual review; no automated pass, finding, or applicability decision asserted.",
          "finding_details": "Raw running config SHA-256: 92b03138bac022b1f2b4e7d9befc64bcbf4a341a2c69f573cb2d172e209eb668\nOfficial Cisco benchmark SHA-256: b92cccf9a63b08507cc8f96c80c7e7976634036a5677a5b151e9aea4a180ef13\nRunning config alone does not verify this control's complete operational check; manual review required.",
          "fix_text": "Configure the Cisco router to enforce password complexity by requiring that at least one uppercase character be used as shown in the example below.\n\nR1(config)#aaa common-criteria policy PASSWORD_POLICY\nR1(config-cc-policy)#upper-case 1\nR1(config-cc-policy)#exit",
          "group_id": "V-215682",
