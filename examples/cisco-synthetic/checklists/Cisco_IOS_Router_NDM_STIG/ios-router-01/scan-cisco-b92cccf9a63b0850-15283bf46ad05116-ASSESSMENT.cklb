          "rule_version": "CISC-ND-000140",
          "severity": "medium",
          "status": "not_reviewed",
          "stig_uuid": "253480f6-e09e-5530-94c9-6b470c156b35",
          "uuid": "4cd071e2-c906-54ad-86e8-0a83047d09a0",
          "weight": "10.0"
        },
        {
          "comments": "NOT REVIEWED — raw running config supplied for manual review; no automated pass, finding, or applicability decision asserted.",
          "finding_details": "Raw running config SHA-256: 92b03138bac022b1f2b4e7d9befc64bcbf4a341a2c69f573cb2d172e209eb668\nOfficial Cisco benchmark SHA-256: b92cccf9a63b08507cc8f96c80c7e7976634036a5677a5b151e9aea4a180ef13\nRunning config alone does not verify this control's complete operational check; manual review required.",
          "fix_text": "Configure the Cisco router to enforce the limit of three consecutive invalid logon attempts as shown in the example below.\n\nR2(config)#login block-for 900 attempts 3 within 120",
          "group_id": "V-215668",
          "group_id_src": "V-215668",
          "group_title": "SRG-APP-000065-NDM-000214",
          "rule_id": "SV-215668r960840_rule",
          "rule_id_src": "SV-215668r960840_rule",
          "rule_title": "The Cisco router must be configured to enforce the limit of three consecutive invalid logon attempts, after which time it must lock out the user account from accessing the device for 15 minutes.",
          "rule_version": "CISC-ND-000150",
          "severity": "medium",
          "status": "not_reviewed",
