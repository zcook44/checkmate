          "rule_title": "The Cisco perimeter router must be configured to drop IPv6 packets containing a Destination Option header with invalid option type values.",
          "rule_version": "CISC-RT-000395",
          "severity": "medium",
          "status": "not_reviewed",
          "stig_uuid": "76bc4350-9460-54c2-bd0a-83e04ef71b52",
