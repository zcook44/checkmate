          "severity": "high",
          "status": "not_reviewed",
          "stig_uuid": "76bc4350-9460-54c2-bd0a-83e04ef71b52",
          "uuid": "f0910415-778b-5bca-8b77-77ee229ba8cc",
          "weight": "10.0"
