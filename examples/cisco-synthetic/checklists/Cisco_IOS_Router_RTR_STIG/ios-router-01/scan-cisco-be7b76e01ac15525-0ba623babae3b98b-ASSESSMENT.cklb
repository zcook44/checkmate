          "rule_version": "CISC-RT-000870",
          "severity": "medium",
          "status": "not_reviewed",
          "stig_uuid": "76bc4350-9460-54c2-bd0a-83e04ef71b52",
          "uuid": "51a7cb6b-d53a-5373-90a6-e93719e63abc",
