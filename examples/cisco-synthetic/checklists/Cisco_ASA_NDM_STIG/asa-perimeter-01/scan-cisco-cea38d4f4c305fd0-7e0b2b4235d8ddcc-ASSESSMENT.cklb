          "fix_text": "Configure the Cisco ASA to authenticate NTP sources using authentication with FIPS-compliant algorithms as shown in the example below:\n\nASA(config)# ntp authenticate \nASA(config)# ntp trusted-key 1\nASA(config)# ntp authentication-key 1 sha256 xxxxxx\nASA(config)# ntp server 10.1.12.2 key 1 prefer\nASA(config)# ntp server 10.1.48.10 key 1\nASA(config)# end",
          "group_id": "V-239929",
          "group_id_src": "V-239929",
          "group_title": "SRG-APP-000395-NDM-000347",
          "rule_id": "SV-239929r1167249_rule",
          "rule_id_src": "SV-239929r1167249_rule",
          "rule_title": "The Cisco ASA must be configured to authenticate Network Time Protocol (NTP) sources using authentication with FIPS-compliant algorithms. ",
          "rule_version": "CASA-ND-001080",
          "severity": "medium",
          "status": "not_reviewed",
          "stig_uuid": "e29d3fd3-66fb-55b8-88d4-3841c0905725",
          "uuid": "7ed0e0a8-24b3-5f3f-91cd-608f984c3ca7",
