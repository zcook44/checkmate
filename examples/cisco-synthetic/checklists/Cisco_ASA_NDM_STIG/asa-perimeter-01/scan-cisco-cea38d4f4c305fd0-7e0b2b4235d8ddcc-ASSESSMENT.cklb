          "rule_version": "CASA-ND-001140",
          "severity": "high",
          "status": "not_reviewed",
          "stig_uuid": "e29d3fd3-66fb-55b8-88d4-3841c0905725",
          "uuid": "83f41aac-1253-5564-8307-8425b1f20fac",
          "weight": "10.0"
