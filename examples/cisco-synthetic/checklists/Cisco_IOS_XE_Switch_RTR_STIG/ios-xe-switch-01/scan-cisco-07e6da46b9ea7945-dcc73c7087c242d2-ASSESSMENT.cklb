          "rule_title": "The Cisco multicast Rendezvous Point (RP) switch must be configured to filter Protocol Independent Multicast (PIM) Register messages received from the Designated switch (DR) for any undesirable multicast groups and sources.",
          "rule_version": "CISC-RT-000830",
          "severity": "low",
          "status": "not_reviewed",
