          "rule_version": "CISC-RT-000060",
          "severity": "low",
          "status": "not_reviewed",
          "stig_uuid": "4318e055-a64a-5bbd-919f-3c0456144285",
          "uuid": "a6643a63-6ab3-52a0-a479-fb3e3093ea79",
          "weight": "10.0"
