          "rule_title": "The Cisco switch must be configured to enforce approved authorizations for controlling the flow of information within the network based on organization-defined information flow control policies.",
          "rule_version": "CISC-RT-000010",
          "severity": "medium",
          "status": "not_reviewed",
          "stig_uuid": "4318e055-a64a-5bbd-919f-3c0456144285",
