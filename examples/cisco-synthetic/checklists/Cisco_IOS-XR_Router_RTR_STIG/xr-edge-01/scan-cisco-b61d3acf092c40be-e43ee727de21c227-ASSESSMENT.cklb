          "rule_id_src": "SV-216814r878125_rule",
          "rule_title": "The Cisco multicast Designated Router (DR) must be configured to filter the Internet Group Management Protocol (IGMP) and Multicast Listener Discovery (MLD) Report messages to allow hosts to join only multicast groups that have been approved by the organization.",
          "rule_version": "CISC-RT-000860",
          "severity": "low",
