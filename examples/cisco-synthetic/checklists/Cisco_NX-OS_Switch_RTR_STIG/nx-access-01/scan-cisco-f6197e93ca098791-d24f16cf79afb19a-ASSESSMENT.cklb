          "rule_title": "The Cisco BGP switch must be configured to use the maximum prefixes feature to protect against route table flooding and prefix de-aggregation attacks.",
          "rule_version": "CISC-RT-000560",
          "severity": "medium",
          "status": "not_reviewed",
