          "severity": "medium",
          "status": "not_reviewed",
          "stig_uuid": "596feb4a-431e-570b-a662-0c09ecde0742",
          "uuid": "59e75374-a54f-5929-8c74-1ae6f7647dc2",
          "weight": "10.0"
