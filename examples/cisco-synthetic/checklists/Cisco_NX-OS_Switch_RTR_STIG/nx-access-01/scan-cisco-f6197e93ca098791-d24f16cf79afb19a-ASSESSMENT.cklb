          "rule_id": "SV-221132r1137908_rule",
          "rule_id_src": "SV-221132r1137908_rule",
          "rule_title": "The Cisco multicast switch must be configured to disable Protocol Independent Multicast (PIM) on all interfaces that are not required to support multicast routing.",
          "rule_version": "CISC-RT-000790",
          "severity": "medium",
          "status": "not_reviewed",
