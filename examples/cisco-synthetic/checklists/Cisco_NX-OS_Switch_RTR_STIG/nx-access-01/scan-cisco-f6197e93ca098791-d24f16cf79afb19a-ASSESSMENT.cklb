          "rule_title": "The Cisco perimeter switch must be configured to only allow incoming communications from authorized sources to be routed to authorized destinations.",
          "rule_version": "CISC-RT-000260",
          "severity": "medium",
          "status": "not_reviewed",
          "stig_uuid": "596feb4a-431e-570b-a662-0c09ecde0742",
