          "rule_title": "The Cisco MPLS switch must be configured to synchronize Interior Gateway Protocol (IGP) and LDP to minimize packet loss when an IGP adjacency is established prior to LDP peers completing label exchange.",
          "rule_version": "CISC-RT-000600",
          "severity": "low",
          "status": "not_reviewed",
          "stig_uuid": "596feb4a-431e-570b-a662-0c09ecde0742",
