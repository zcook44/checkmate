          "severity": "low",
          "status": "not_reviewed",
          "stig_uuid": "ac88c1be-1d0e-510f-b4c0-519c3e17f631",
          "uuid": "cd354072-c22b-586c-a570-0501a7468f26",
          "weight": "10.0"
