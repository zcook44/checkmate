          "finding_details": "Raw running config SHA-256: be6b611a6ce3af30cfad1166d418ae98034301b63423515ba5bf0b069a79f313\nOfficial Cisco benchmark SHA-256: 6ea04e54af46122495d50fe5810cf2021e5eec12b22c3b4bcad667d91dfc54c9\nRunning config alone does not verify this control's complete operational check; manual review required.",
          "fix_text": "Remove the assignment of the default VLAN from all access switch ports.",
          "group_id": "V-220642",
          "group_id_src": "V-220642",
          "group_title": "SRG-NET-000512-L2S-000008",
          "rule_id": "SV-220642r991849_rule",
